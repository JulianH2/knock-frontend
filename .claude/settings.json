{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Edit(/.github/**)",
      "Edit(/.claude/**)",
      "Edit(/.githooks/**)",
      "Edit(/.specify/memory/**)",
      "Edit(/scripts/**)",
      "Edit(/constitution.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/.semgrep/**)",
      "Edit(/stryker-config.json)",
      "Edit(/security/exceptions.yaml)",
      "Edit(/.agents/knock.json)",
      "Edit(/app/packages/knock_api/**)",
      "Edit(/panel/src/app/api/**)",
      "Edit(/contracts/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/appsettings.Development.json)",
      "Read(**/*.keystore)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(* --no-verify *)",
      "mcp__atlassian__addCommentToJiraIssue",
      "mcp__atlassian__addWorklogToJiraIssue",
      "mcp__atlassian__createJiraIssue",
      "mcp__atlassian__editJiraIssue",
      "mcp__atlassian__transitionJiraIssue",
      "mcp__atlassian__createIssueLink",
      "mcp__atlassian__createConfluencePage",
      "mcp__atlassian__createConfluenceFooterComment",
      "mcp__atlassian__createConfluenceInlineComment",
      "mcp__atlassian__updateConfluencePage",
      "mcp__atlassian__createCompassComponent",
      "mcp__atlassian__createCompassComponentRelationship",
      "mcp__atlassian__createCompassCustomFieldDefinition",
      "mcp__atlassian__addTeamworkGraphContext"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(dotnet ef database *)",
      "Bash(docker system prune *)"
    ],
    "allow": [
      "Bash(python3 scripts/*)",
      "Bash(python scripts/*)",
      "Bash(dotnet restore *)",
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(flutter analyze *)",
      "Bash(flutter test *)",
      "Bash(dart format *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "mcp__atlassian__atlassianUserInfo",
      "mcp__atlassian__getAccessibleAtlassianResources",
      "mcp__atlassian__getVisibleJiraProjects",
      "mcp__atlassian__getJiraIssue",
      "mcp__atlassian__searchJiraIssuesUsingJql",
      "mcp__atlassian__getJiraProjectIssueTypesMetadata",
      "mcp__atlassian__getJiraIssueTypeMetaWithFields",
      "mcp__atlassian__getTransitionsForJiraIssue",
      "mcp__atlassian__getJiraIssueRemoteIssueLinks",
      "mcp__atlassian__getIssueLinkTypes",
      "mcp__atlassian__lookupJiraAccountId"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/knock_guard.py\" session-start --tool claude",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/knock_guard.py\" pre-tool --tool claude",
            "timeout": 90
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/knock_guard.py\" stop --tool claude",
            "timeout": 900,
            "statusMessage": "knock-guard: verificando antes de terminar"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/knock_guard.py\" stop --tool claude",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
