{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/hooks/knock_guard.py\" session-start --tool gemini"
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "matcher": "write_file|replace|edit|run_shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/hooks/knock_guard.py\" pre-tool --tool gemini"
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/hooks/knock_guard.py\" stop --tool gemini"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "atlassian": {
      "httpUrl": "https://mcp.atlassian.com/v1/mcp/authv2",
      "includeTools": [
        "atlassianUserInfo",
        "getAccessibleAtlassianResources",
        "getVisibleJiraProjects",
        "getJiraIssue",
        "searchJiraIssuesUsingJql",
        "getJiraProjectIssueTypesMetadata",
        "getJiraIssueTypeMetaWithFields",
        "getTransitionsForJiraIssue",
        "getJiraIssueRemoteIssueLinks",
        "getIssueLinkTypes",
        "lookupJiraAccountId"
      ],
      "excludeTools": [
        "addCommentToJiraIssue",
        "addWorklogToJiraIssue",
        "createJiraIssue",
        "editJiraIssue",
        "transitionJiraIssue",
        "createIssueLink",
        "createConfluencePage",
        "createConfluenceFooterComment",
        "createConfluenceInlineComment",
        "updateConfluencePage",
        "createCompassComponent",
        "createCompassComponentRelationship",
        "createCompassCustomFieldDefinition",
        "addTeamworkGraphContext"
      ]
    }
  }
}
